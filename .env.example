# Copy to .env on the server. Never commit this file or paste secrets into chat.
# DOMAIN is the chosen hostname only: no https:// and no trailing slash.
DOMAIN=
ACME_EMAIL=mementokigali@gmail.com
RELEASE_TAG=launch-1
# Generate 32 random bytes as hex; URL-safe, no spaces or punctuation.
POSTGRES_PASSWORD=
# Clerk PRODUCTION instance for the final domain; publishable key is public.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Exact verified email used by the owner to sign in, not necessarily business email.
ADMIN_EMAIL=
# Use the business mailbox or an approved transactional email service.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mementokigali@gmail.com
SMTP_PASS=
SMTP_FROM="Memento <mementokigali@gmail.com>"
# Local development only (Compose constructs these itself).
DATABASE_URL=
PUBLIC_ORIGIN=http://localhost:5173
